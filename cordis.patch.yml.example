# Example DSH profile patch entry for dsh-ark-quota.
# Copy this into your profile's cordis.patch.yml, replacing the PASTE_*
# placeholders with your OWN Volcengine access keys.
# NEVER commit real access keys.
#
# The access keys are secrets: you may leave them empty here and fill them in
# from the DSH Settings UI instead (Settings → 方舟额度), which writes them to
# $DSH_HOME/settings.yaml via the plugin's own /ark-quota/credentials route and
# hot-applies them — no restart.
- insert:
    - id: ark-quota
      name: dsh-ark-quota
      config:
        accessKeyId: ''
        secretAccessKey: ''
        region: cn-beijing
        version: '2024-01-01'
        refreshMs: 300000
